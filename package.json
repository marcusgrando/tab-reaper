{
  "name": "tab-reaper",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "icons": "bun run scripts/generate-icons.ts",
    "package": "bun run build && rm -f dist/tab-reaper-extension.zip && (cd dist && zip -qr tab-reaper-extension.zip .)",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:rust": "CARGO_TARGET_DIR=${HOME}/.cache/tab-reaper/target cargo test --manifest-path native-host/Cargo.toml",
    "build:host": "CARGO_TARGET_DIR=${HOME}/.cache/tab-reaper/target cargo build --release --manifest-path native-host/Cargo.toml"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.0"
  }
}
