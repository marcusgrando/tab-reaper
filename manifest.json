{
  "manifest_version": 3,
  "name": "Tab Reaper",
  "version": "0.6.0",
  "description": "Strict Chrome memory budget, banded tab discarding, fast startup, and conflict-free session backup.",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "system.memory",
    "tabGroups"
  ],
  "optional_permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Reaper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Open Tab Reaper tab palette"
    }
  }
}
